{
  "name": "flukeshell",
  "version": "1.0.0",
  "description": "A Windows terminal built for Claude Code: vertical tabs that light up when Claude is done, has a question or breaks.",
  "private": true,
  "main": "main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "electron .",
    "postinstall": "node node_modules/electron/install.js && node build-exe.js",
    "test": "node test-setup-hooks.js"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.0.0",
    "rcedit": "^5.0.2"
  }
}
